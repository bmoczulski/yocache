# Build output
/yocache
/dist/
/bin/

# Web dashboard build artefacts (Svelte + Vite, embedded via //go:embed).
# Unanchored — the /dist/ above only matches goreleaser's root output.
# Keeping these ignored keeps goreleaser's clean-tree check green in CI.
cmd/yocache/web/node_modules/
cmd/yocache/web/dist/

# Containerised toolchain caches (HOME, GOPATH, build/module cache)
/.cache/

# Local data the daemon may write (blob store, sqlite/duckdb files)
/var*
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.duckdb

# Dev-session log captures
*.log

# Local config overrides
yocache.local.toml

# Local working notes
TODO.md

# One-off local goreleaser validation wrapper (not part of the standard dev flow)
/goreleaser

# Editor / OS
.idea/
.vscode/*
!.vscode/settings.json
*.swp
.DS_Store
